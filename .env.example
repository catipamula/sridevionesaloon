# Sri Devi One Saloon - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.

# -----------------------------------------------------------------------------
# Web Application Host URL (Used for booking & unsubscribe links in emails)
# -----------------------------------------------------------------------------
APP_URL=https://sridevionesaloon.onrender.com

# -----------------------------------------------------------------------------
# OPTION A: Standard Gmail SMTP (Default & Primary)
# Note: Google requires a 16-character App Password (not your normal Gmail password).
# On local hosting, VPS, or Render Paid plans, outbound port 587 works directly.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-gmail@gmail.com
SMTP_APP_PASSWORD=your-16-char-google-app-password
SMTP_CHECK_ON_STARTUP=false

# -----------------------------------------------------------------------------
# OPTION B: HTTP Email APIs (Resilient Fallback for Render Free Tier)
# Note: Render Free Tier blocks outbound SMTP ports 25, 465, and 587.
# When running on Render Free Tier, having RESEND_API_KEY or BREVO_API_KEY
# guarantees emails deliver seamlessly via HTTPS (Port 443).
# -----------------------------------------------------------------------------
# Resend (Get a free key from https://resend.com - 3,000 free emails/month):
RESEND_API_KEY=
# Brevo / Sendinblue (Get a free key from https://brevo.com - 300 free emails/day):
BREVO_API_KEY=
# Custom verified sender:
EMAIL_SENDER=Sri Devi One Saloon <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# Salon Business Details
# -----------------------------------------------------------------------------
SALON_NAME=Sri Devi One Saloon
SALON_EMAIL=pavankoneti85@gmail.com
SALON_PHONE=+91 73961 44248
SALON_ADDRESS=Bommuru Centre, Near NTR Statue, Rajuvolu Road, Kotta Bommuru, AP 533124, India
SALON_MAPS_URL=https://maps.app.goo.gl/suHNM6yaQBY29TX8A
SALON_TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# Appointment & Scheduling Settings
# -----------------------------------------------------------------------------
SERVICE_DURATION_MINUTES=60
FOLLOWUP_INTERVAL_MONTHS=1
ENABLE_MONTHLY_FOLLOWUPS=true
MAX_EMAIL_RETRIES=3

# Optional secret token to secure the /api/cron/process-scheduled-jobs webhook
CRON_SECRET=

# -----------------------------------------------------------------------------
# Admin Dashboard & CMS Authentication
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=pavankoneti85@gmail.com
ADMIN_PASSWORD=SriDevi@Admin2026
FLASK_SECRET_KEY=sridevi-one-saloon-session-secret-key-2026
