# Sri Devi One Saloon - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.

# -----------------------------------------------------------------------------
# OPTION A (RECOMMENDED FOR RENDER FREE TIER): HTTP Email API (Port 443)
# Render Free Tier blocks outbound SMTP ports 25, 465, and 587.
# Using Resend or Brevo over HTTPS (Port 443) works 100% reliably on Render Free Tier.
# -----------------------------------------------------------------------------
# Resend (Get a free key from https://resend.com - 3000 free emails/mo):
RESEND_API_KEY=
# Brevo / Sendinblue (Get a free key from https://brevo.com - 300 free emails/day):
BREVO_API_KEY=
# Custom verified sender (e.g., Sri Devi One Saloon <onboarding@resend.dev> or your verified domain):
EMAIL_SENDER=

# -----------------------------------------------------------------------------
# OPTION B: Standard Gmail SMTP (Requires Render Paid Plan or local hosting)
# Note: Google requires a 16-character App Password (not your normal Gmail password).
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-gmail@gmail.com
SMTP_APP_PASSWORD=your-16-char-google-app-password
SMTP_CHECK_ON_STARTUP=false

# -----------------------------------------------------------------------------
# Salon Business Details
# -----------------------------------------------------------------------------
SALON_TIMEZONE=Asia/Kolkata
SALON_NAME=Sri Devi One Saloon
SALON_EMAIL=your-salon-notifications@gmail.com
SALON_ADDRESS=Bommuru Centre, Near NTR Statue, Rajuvolu Road, Kotta Bommuru, AP 533124, India
SALON_PHONE=+91 73961 44248
SALON_MAPS_URL=https://maps.app.goo.gl/suHNM6yaQBY29TX8A

# -----------------------------------------------------------------------------
# Appointment & Scheduling Settings
# -----------------------------------------------------------------------------
SERVICE_DURATION_MINUTES=60
FOLLOWUP_INTERVAL_MONTHS=1
ENABLE_MONTHLY_FOLLOWUPS=false
MAX_EMAIL_RETRIES=3
